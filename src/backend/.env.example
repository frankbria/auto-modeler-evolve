# AutoModeler backend environment variables.
# Copy to `.env` (or export in your shell) and fill in real values.

# --- Authentication (REQUIRED for any non-local / multi-user deployment) ---
# Secret used to sign JWT access tokens (HS256). Use a long random string,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# If unset, the backend falls back to an INSECURE development secret and logs
# a warning at startup — never rely on the default outside local development.
AUTH_SECRET=

# Optional: access-token lifetime in minutes (default 10080 = 7 days).
# AUTH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
# Comma-separated list of allowed browser origins. Default is the local frontend
# (http://localhost:3000). Set this to your deployed frontend origin(s) in prod.
# Credentials are NOT sent cross-origin (auth is Bearer-token, not cookies).
# CORS_ORIGINS=http://localhost:3000,https://app.example.com

# --- Uploads ---
# Max upload size in MB across all upload endpoints (default 100). Oversized
# uploads get HTTP 413.
# MAX_UPLOAD_SIZE_MB=100

# --- Webhooks ---
# Key used to encrypt webhook signing secrets at rest (core.secret_box). Falls
# back to AUTH_SECRET when unset. Rotating it makes existing webhook secrets
# undecryptable (their next dispatch is skipped) — re-create those webhooks.
# WEBHOOK_SECRET_KEY=

# --- LLM (chat narration, query engine, data dictionary) ---
# ANTHROPIC_API_KEY=
# Optional model override for cheap narration/query calls.
# QUERY_MODEL=claude-haiku-4-5-20251001

# --- Observability ---
# Root log level (default INFO). Logs go to the console and a rotating file at
# <DATA_DIR>/logs/app.log. Set DEBUG for verbose local debugging.
# LOG_LEVEL=INFO
